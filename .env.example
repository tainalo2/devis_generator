# Devis Generator : VIBED — variables d'environnement

# Obligatoires / principales
DATABASE_URL=postgres://devis:devis@127.0.0.1:5432/devis?sslmode=disable
APP_ENV=development
ADDR=0.0.0.0:8080
SHUTDOWN_TIMEOUT=10s

# Auth / chiffrement applicatif
# En production (APP_ENV=production) : obligatoires et non faibles.
# SESSION_SECRET : ≥ 32 caractères (sessions + CSRF).
SESSION_SECRET=dev-only-session-secret-change-me-32b
# ENCRYPTION_KEY : 32 octets en base64 (AES-256-GCM pour IBAN/adresses).
# Exemple (à remplacer) : openssl rand -base64 32
ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

# Optionnelles
STATIC_DIR=../frontend/dist
STARTUP_TIMEOUT=2m
SESSION_TTL=720h
# COOKIE_SECURE=true  # forcé en production ; utile derrière HTTPS en staging
# Reverse proxies autorisés à fournir X-Forwarded-For (CIDR ou IP, séparés par des virgules).
# Sans cette variable, l'IP du client est celle de la connexion TCP : derrière un proxy,
# renseignez son réseau, sinon toutes les requêtes partagent la même limite de débit.
# TRUSTED_PROXIES=172.16.0.0/12
# ARGON2_TIME=3
# ARGON2_MEMORY=65536
# ARGON2_THREADS=2
# ARGON2_KEYLEN=32

# Sources légales (aucune clé API — URLs publiques optionnelles pour tests / miroirs)
# LEGAL_REFRESH_ENABLED=true
# LEGAL_REFRESH_INTERVAL=24h
# LEGAL_HTTP_TIMEOUT=8s
# LEGAL_RECHERCHE_BASE_URL=https://recherche-entreprises.api.gouv.fr
# LEGAL_VIES_URL=https://ec.europa.eu/taxation_customs/vies/rest-api/check-vat-number
# LEGAL_TEDB_URL=https://ec.europa.eu/taxation_customs/tedb/ws/VatRetrievalService
# LEGAL_BCE_URL=https://data-api.ecb.europa.eu/service/data/FM/B.U2.EUR.4F.KR.MRR_FR.LEV?lastNObservations=1&format=jsondata

# Site public (landing / mentions) — laisser vide = affiché « à compléter », aucune identité inventée
# DONATE_URL=https://exemple.org/soutenir
# LEGAL_PUBLISHER_NAME=
# LEGAL_PUBLISHER_ADDRESS=
# LEGAL_PUBLISHER_EMAIL=
# LEGAL_PUBLISHER_SIRET=
# LEGAL_HOST_NAME=
# LEGAL_HOST_ADDRESS=
# LEGAL_HOST_URL=
