# Devis Generator : VIBED — variables d'environnement

# Obligatoires / principales
DATABASE_URL=postgres://devis:devis@127.0.0.1:5432/devis?sslmode=disable
APP_ENV=development
ADDR=0.0.0.0:8080
SHUTDOWN_TIMEOUT=10s

# Optionnelles
# Chemin du front buildé (relatif au cwd du processus, souvent backend/ en local).
STATIC_DIR=../frontend/dist
# Délai max pour attendre Postgres + migrations au démarrage (retries).
STARTUP_TIMEOUT=2m
